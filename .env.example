# Copie ce fichier en ".env" et remplis les valeurs (voir README > "Configuration Supabase").
# URL DE BASE du projet Supabase (Dashboard > Settings > API > Project URL).
# ⚠️ PAS l'URL "/rest/v1/" — juste "https://<ref>.supabase.co"
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé publique "anon" / "publishable" (Dashboard > Settings > API > Project API keys).
# C'est une clé PUBLIQUE, prévue pour être exposée côté navigateur : ce n'est pas un secret.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
